#!/usr/bin/env sh

echo "🔍 Running pre-push checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_info() {
    echo -e "${YELLOW}ℹ${NC} $1"
}

# Exit on any error
set -e

print_info "Step 1/3: Running lint checks..."
if npm run lint:fix; then
    print_status "Lint checks passed"
else
    print_error "Lint checks failed"
    exit 1
fi

print_info "Step 2/3: Building backend..."
if npm run build; then
    print_status "Backend and Frontend build successful"
else
    print_error "Backend and Frontend build failed"
    exit 1
fi

print_info "Step 3/3: All checks completed successfully!"
print_status "Ready to push! 🚀"