#!/usr/bin/env sh

echo "🔍 Running pre-push checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_info() {
    echo -e "${YELLOW}ℹ${NC} $1"
}

# Exit on any error
set -e

run_step() {
    print_info "Step $1/6: $2..."
    if npm run "$3"; then
        print_status "$2 passed"
    else
        print_error "$2 failed"
        exit 1
    fi
}

run_step 1 "Lint" lint
run_step 2 "Build" build
run_step 3 "Type check" typecheck
run_step 4 "Module boundaries" check:architecture
run_step 5 "Unit tests" test

print_info "Step 6/6: All CI checks except integration tests completed successfully!"
print_status "Ready to push! 🚀"
