    "rxjs": "^7.8.2",
    "tslib": "^2.5.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@types/jest": "^30.0.0",
