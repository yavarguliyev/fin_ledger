# Local stack: Postgres, Redis, RabbitMQ, Kafka, MinIO and console e-mail (infrastructure/dev).
# Copy to .env.local. To run against AWS services instead, also copy .env.aws.example to .env.aws;
# its values win over this file, and deleting it switches back.

# App Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated process roles this instance runs: API, WORKER, REALTIME, REPORTS
PROCESS_ROLES=API,WORKER
# Number of reverse proxies in front of the API (0 = direct)
TRUST_PROXY=0
# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
EMAIL_FROM=noreply@realtime-wallet-payments.com

# jwt configs
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=15m
JWT_ISSUER=realtime-wallet-payments
JWT_AUDIENCE=realtime-wallet-payments-users

# Redis Cache Cluster
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_HOST=localhost

# Database (PostgreSQL) Configuration
# The API connects as a least-privilege login (not the table owner). Create or update it after migrating:
# npm run migrate:up && npm run db:provision-roles
DB_HOST=127.0.0.1
DB_PORT=54320
APP_API_DB_USERNAME=app_api
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=distributed_db
DB_NAME=distributed_db
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_MIN_LIMIT=2
DB_CONNECTION_TIMEOUT=5000
DB_ACQUIRE_TIMEOUT=5000
DB_PRIMARY_POOL_MAX=20
# Owner connection: migrations and db:provision-roles only, never the API
DATABASE_URL=postgresql://postgres:password@127.0.0.1:54320/distributed_db

# RabbitMQ
RABBITMQ_DEFAULT_USER=ddd_user
RABBITMQ_DEFAULT_PASS=ddd_pass
RABBITMQ_DEFAULT_HOST=localhost

# Distributed Kafka Streaming
KAFKA_BROKER_HOST='127.0.0.1'
KAFKA_BROKER_PORT=9092
KAFKA_CONSUMER_GROUP_ID=core-api-consumer-group

# Payment Provider configs

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Two-factor authentication: 32 random bytes, base64 (generate with: openssl rand -base64 32)
MFA_ENCRYPTION_KEY=

# E-mail links (reset, verification, invitation) are encrypted in the outbox and Kafka: 32 random bytes, base64
EMAIL_LINK_ENCRYPTION_KEY=
ALERT_WEBHOOK_TOKEN=

# Webhook replay job (optional; defaults 60000 / 300000): re-handles events whose handling failed
WEBHOOK_REPLAY_INTERVAL_MS=60000
WEBHOOK_REPLAY_STALE_AFTER_MS=300000

# Payment reconciliation job (optional): finishes deposits whose webhook never arrived
PAYMENT_RECONCILE_INTERVAL_MS=60000
PAYMENT_RECONCILE_STALE_AFTER_MS=600000
PAYMENT_ACTION_EXPIRY_MS=86400000

# Ledger integrity job (optional): checks wallet/ledger drift and the trial balance
LEDGER_INTEGRITY_INTERVAL_MS=300000

# Betting (optional): house margin applied to the offered odds, p = 1 / (odds * (1 + margin))
BETTING_MARGIN=0.05
MFA_ISSUER=Realtime Wallet

# Storage (MinIO)
STORAGE_STRATEGY=s3
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=realtime-wallet-payments
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ENSURE_BUCKET=true

# Passkeys. Both default from FRONTEND_URL, so local dev needs neither.
# Ask for the passkey again before a withdrawal. Off unless set to true.
PASSKEY_RP_NAME=Wallet
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:4200
PASSKEY_STEP_UP_ENABLED=false

# Support calls (WebRTC). JSON list of ICE servers; empty uses a public STUN server, [] disables it.
# Strict corporate and mobile networks still need a TURN relay.
# Example: [{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
SUPPORT_ICE_SERVERS=

# Outbox relay (optional; defaults 50 / 5000): events claimed per batch and the idle poll interval
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=5000

# libuv thread pool for crypto, argon2 and sharp (optional; unset means the CPU count, 4 to 16)
# UV_THREADPOOL_SIZE=8
