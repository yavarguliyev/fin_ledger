      "type": "timeseries",
      "title": "Outbox events",
      "description": "Events waiting to be published to RabbitMQ or Kafka, and those that gave up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "core_api_outbox_events_pending{job=\"$job\"}",
          "legendFormat": "pending",
          "refId": "N"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "core_api_outbox_events_dead{job=\"$job\"}",
          "legendFormat": "dead",
          "refId": "O"
        }
      ],
      "fieldConfig": {
