  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0
      },
      {
        "name": "database",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(pg_database_size_bytes, datname)",
          "refId": "db"
        },
        "definition": "label_values(pg_database_size_bytes, datname)",
        "refresh": 2,
        "current": {
          "text": "distributed_db",
          "value": "distributed_db"
        },
        "hide": 0
      }
    ]
  },
