{
  "name": "realtime-wallet-payments",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": ["packages/*", "apps/core-api", "apps/client"],
  "scripts": {
    "install:all": "npm install",
    "install:deps": "npm install",
    "clean:node_modules": "rm -rf node_modules packages/*/node_modules apps/*/node_modules apps/client/.angular apps/client/node_modules/.cache package-lock.json && npm cache clean --force",
    "install:clean": "npm run clean:node_modules && npm install",
    "generate:keys": "bash scripts/generate-rsa-keys.sh",
    "build": "turbo run build",
    "clean": "node scripts/clean-artifacts.mjs",
    "clean:all": "npm run clean && npm run clean:node_modules",
    "dev": "node scripts/start-all.mjs",
    "dev:api": "bash scripts/dev.sh api",
    "dev:client": "npm run dev -w apps/client",
    "build:api": "turbo run build --filter=@core/api",
    "remove:running:port": "lsof -ti:3000 | xargs kill -9",
    "dev:stop": "lsof -ti:3000,4200 -sTCP:LISTEN | xargs kill 2>/dev/null; pkill -f 'scripts/start-all.mjs' || true",
    "build:client": "turbo run build --filter=@core/client",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --filter=@core/api",
    "lint": "turbo run lint",
    "lint:fix": "eslint \"**/{src,test}/**/*.ts\" --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{json,mjs,js,html}\" && npm run lint:fix",
    "format:check": "prettier --check \"**/*.{json,mjs,js,html}\" && turbo run lint",
    "migrate:up": "node-pg-migrate up --migrations-dir apps/core-api/migrations",
    "migrate:down": "node-pg-migrate down --migrations-dir apps/core-api/migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir apps/core-api/migrations",
    "db:provision-roles": "node --env-file-if-exists=apps/core-api/.env scripts/db/provision-login-roles.mjs",
    "mq:dlq": "node --env-file-if-exists=apps/core-api/.env scripts/rabbitmq/dlq.mjs",
    "infra:up:dev": "bash infrastructure/dev/start.sh",
    "infra:down:dev": "bash infrastructure/dev/stop.sh",
    "infra:restart:dev": "bash infrastructure/dev/restart.sh",
    "infra:rm:dev": "bash infrastructure/dev/remove.sh",
    "infra:verify": "node --env-file-if-exists=apps/core-api/.env --env-file-if-exists=infrastructure/dev/.env scripts/infra/verify-monitoring.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "argon2": "^0.45.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.12",
    "turbo": "^2.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.20.0",
    "uuid": "^14.0.2",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
