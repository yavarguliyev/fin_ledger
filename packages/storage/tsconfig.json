{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "declarationDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node", "jest"]
  },
  "references": [
    {
      "path": "../shared-libs"
    },
    {
      "path": "../redis"
    }
  ],
  "include": ["src/**/*.ts", "test/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["dist", "node_modules", "src/**/*.d.ts"]
}
